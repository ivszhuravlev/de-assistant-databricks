{
  "pipeline_name": "nyc_taxi_january_2021",
  "target": {
    "catalog": "hive_metastore",
    "schemas": ["bronze", "silver", "gold", "de_assist"],
    "generated_schemas": ["gen_bronze", "gen_silver", "gen_gold", "de_assist"],
    "hive_name_rule": "Logical layer names stay bronze/silver/gold. Resolve Hive with paths.table(layer, table) from config.output_space. Never literal bronze./gen_bronze.",
    "table_style": "external_delta",
    "storage_root": "dbfs:/de-assist-databricks",
    "backend": "adls"
  },
  "raw": {
    "root": "abfss://<container>@<adls_account>.dfs.core.windows.net/taxi_data",
    "already_landed": true,
    "files": {
      "yellow": "abfss://<container>@<adls_account>.dfs.core.windows.net/taxi_data/yellow/yellow_tripdata_2021-01.csv.gz",
      "green": "abfss://<container>@<adls_account>.dfs.core.windows.net/taxi_data/green/green_tripdata_2021-01.csv.gz",
      "zones": [
        "abfss://<container>@<adls_account>.dfs.core.windows.net/taxi_data/taxi_zone_lookup.csv",
        "abfss://<container>@<adls_account>.dfs.core.windows.net/taxi_data/lookup/taxi_zone_lookup.csv"
      ]
    },
    "read_options": {"header": "true", "inferSchema": "true"},
    "source_month": "2021-01"
  },
  "identity": ["vendor_id", "pickup_datetime", "pickup_location_id", "service_type"],
  "money_type": "decimal(18,2)",
  "layers": {
    "bronze": [
      {
        "schema": "bronze",
        "name": "yellow_tripdata",
        "source": "yellow",
        "pickup_column": "tpep_pickup_datetime",
        "partition_by": ["pickup_date"],
        "expected_count": 1369765,
        "required_columns": ["VendorID", "tpep_pickup_datetime", "_source_file", "_ingested_at", "pickup_date"]
      },
      {
        "schema": "bronze",
        "name": "green_tripdata",
        "source": "green",
        "pickup_column": "lpep_pickup_datetime",
        "partition_by": ["pickup_date"],
        "expected_count": 76518,
        "required_columns": ["VendorID", "lpep_pickup_datetime", "_source_file", "_ingested_at", "pickup_date"]
      },
      {
        "schema": "bronze",
        "name": "taxi_zone_lookup",
        "source": "zones",
        "partition_by": [],
        "expected_count": 265,
        "unique_grain": ["LocationID"],
        "required_columns": ["LocationID", "Borough", "Zone", "service_zone", "_source_file", "_ingested_at"]
      }
    ],
    "silver": [
      {
        "schema": "silver",
        "name": "rejected_trips",
        "from": ["bronze.yellow_tripdata", "bronze.green_tripdata"],
        "rule": "null vendor_id or null pickup_datetime",
        "reject_reason": "null_vendor_id | null_pickup_datetime",
        "partition_by": ["pickup_date"],
        "required_columns": ["vendor_id", "pickup_datetime", "reject_reason", "_source_file", "pickup_date"]
      },
      {
        "schema": "silver",
        "name": "trips",
        "from": ["bronze.yellow_tripdata", "bronze.green_tripdata"],
        "yellow_pickup": "tpep_pickup_datetime",
        "yellow_dropoff": "tpep_dropoff_datetime",
        "green_pickup": "lpep_pickup_datetime",
        "green_dropoff": "lpep_dropoff_datetime",
        "service_type": {"yellow": "Yellow", "green": "Green"},
        "dedupe": "identity grain, keep first by dropoff_datetime then _source_file",
        "trip_id": "sha2 of identity columns",
        "partition_by": ["pickup_date"],
        "unique_grain": ["vendor_id", "pickup_datetime", "pickup_location_id", "service_type"],
        "required_columns": ["vendor_id", "pickup_datetime", "pickup_location_id", "service_type", "dropoff_datetime", "trip_id", "pickup_date", "_source_file"]
      }
    ],
    "gold": [
      {
        "schema": "gold",
        "name": "dim_zones",
        "from": ["bronze.taxi_zone_lookup"],
        "columns": {
          "LocationID": "location_id int",
          "Borough": "borough string",
          "Zone": "zone string",
          "service_zone": "service_zone string"
        },
        "unique_grain": ["location_id"],
        "expected_count": 265
      },
      {
        "schema": "gold",
        "name": "fct_trips",
        "from": ["silver.trips", "gold.dim_zones"],
        "join": "left join dim_zones on pickup_location_id and dropoff_location_id",
        "must_not_drop_rows": true,
        "partition_by": ["pickup_date"],
        "unique_grain": ["trip_id"],
        "required_columns": ["trip_id", "pickup_zone", "dropoff_zone", "pickup_date", "total_amount"]
      },
      {
        "schema": "gold",
        "name": "fct_monthly_zone_revenue",
        "from": ["gold.fct_trips"],
        "grain": ["pickup_zone", "revenue_month", "service_type"],
        "revenue_month": "date_trunc month of pickup_datetime",
        "unknown_zone": "Unknown Zone",
        "measures": [
          "sum fare_amount as revenue_monthly_fare",
          "sum extra as revenue_monthly_extra",
          "sum mta_tax as revenue_monthly_mta_tax",
          "sum tip_amount as revenue_monthly_tip_amount",
          "sum tolls_amount as revenue_monthly_tolls_amount",
          "sum ehail_fee as revenue_monthly_ehail_fee",
          "sum improvement_surcharge as revenue_monthly_improvement_surcharge",
          "sum total_amount as revenue_monthly_total_amount",
          "count trip_id as total_monthly_trips",
          "avg passenger_count as avg_monthly_passenger_count",
          "avg trip_distance as avg_monthly_trip_distance"
        ],
        "reconcile_to": "gold.fct_trips"
      }
    ]
  }
}
